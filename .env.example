# =========================================================================
# LUMISOCIAL Command Center — Environment Variables
# Copy this file to ".env" and fill in the values you have.
# EVERY key below is OPTIONAL — the app runs at $0 with none of them set.
# Connectors without credentials simply show a friendly "setup" card and are
# skipped; all no-auth sources keep working.
# =========================================================================

# -------------------------------------------------------------------------
# 1. TELEGRAM (live public channels)  —  https://my.telegram.org
#    After filling these, run once:  python telegram_login.py
# -------------------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# -------------------------------------------------------------------------
# 2. TWITTER / X (API v2)  —  https://developer.x.com/  (Bearer Token)
#    Note: free tier returns ~7 days only; excluded from deep-history totals.
# -------------------------------------------------------------------------
TWITTER_BEARER_TOKEN=

# -------------------------------------------------------------------------
# 3. YOUTUBE (video comments)  —  https://console.cloud.google.com/
#    Enable "YouTube Data API v3" and create an API Key.
# -------------------------------------------------------------------------
YOUTUBE_API_KEY=

# -------------------------------------------------------------------------
# 4. REDDIT (public subreddits/threads)  —  https://www.reddit.com/prefs/apps
#    Create a "script" app.
# -------------------------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=public-figure-monitor/1.0 by yourusername

# -------------------------------------------------------------------------
# 5. NO API KEY NEEDED (free & ready by default):
#    30+ Indian newspaper RSS · Google News · GDELT archive · Bluesky ·
#    Mastodon · Hacker News
# -------------------------------------------------------------------------

# Optional: enable the heavier local AI models (see requirements-ai.txt)
# SENTIMENT_BACKEND=transformer
# EMOTION_BACKEND=transformer
