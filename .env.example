# =========================================================================
# LUMISOCIAL Command Center — Environment Variables Template (.env.example)
# Copy this file to '.env' and fill in your credentials.
# =========================================================================

# -------------------------------------------------------------------------
# 1. TELEGRAM INTEGRATION (Live Public News & Discussion Channels)
# Get free api_id & api_hash at https://my.telegram.org (under API development tools)
# Then run: python telegram_login.py (to authorize session once)
# -------------------------------------------------------------------------
TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID_HERE
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH_HERE

# -------------------------------------------------------------------------
# 2. TWITTER / X (Official API v2)
# Register at https://developer.x.com/ and create a Bearer Token
# -------------------------------------------------------------------------
TWITTER_BEARER_TOKEN=YOUR_TWITTER_BEARER_TOKEN_HERE

# -------------------------------------------------------------------------
# 3. YOUTUBE INTEGRATION (YouTube Video Comments)
# Enable "YouTube Data API v3" at https://console.cloud.google.com/
# -------------------------------------------------------------------------
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# -------------------------------------------------------------------------
# 4. REDDIT INTEGRATION (Public Subreddits & Threads)
# Register script app at https://www.reddit.com/prefs/apps
# -------------------------------------------------------------------------
REDDIT_CLIENT_ID=YOUR_REDDIT_CLIENT_ID_HERE
REDDIT_CLIENT_SECRET=YOUR_REDDIT_CLIENT_SECRET_HERE
REDDIT_USER_AGENT="lumisocial-monitor by u/YOUR_REDDIT_USERNAME"

# -------------------------------------------------------------------------
# 5. NO API KEY NEEDED (100% Free Out of the Box):
# - 📰 30+ Indian National & Regional Newspapers RSS (TOI, HT, Hindu, Express, etc.)
# - 🌐 Google News (Global & India editions)
# - 🦋 Bluesky Social Network (Public feed)
# - 🐘 Mastodon Decentralized Network
# - 🟠 Hacker News
# -------------------------------------------------------------------------
